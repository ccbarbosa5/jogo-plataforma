descricao = "Se as 3 balas da rajada acertam o mesmo alvo, a 3ª é crítica (×2)."
marcadores = Array[StringName]([&"rajada_critico_3"])

[sub_resource type="Resource" id="no5"]
script = ExtResource("4")
id = &"execucao"
nome = "Execução"
descricao = "Crítico em inimigo comum com menos de 25% de vida mata na hora. Em elites e chefes, o crítico causa ×3."
