[sub_resource type="Resource" id="no2"]
script = ExtResource("4")
id = &"grande_arena"
nome = "Grande Arena"
descricao = "Com o Embalo cheio, cada 10º tiro é um Golpe do Campeão: 40 de dano, dobrado contra elites e chefes."
marcadores = Array[StringName]([&"golpe_do_campeao"])

[sub_resource type="Resource" id="no3"]
script = ExtResource("4")
id = &"disciplina"
nome = "Disciplina"
descricao = "Rajadas de 3 tiros, +20% de dano por bala."
