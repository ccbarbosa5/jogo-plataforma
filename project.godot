[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jogador"
2d_physics/layer_3="inimigos"
2d_physics/layer_4="projeteis_jogador"
2d_physics/layer_5="projeteis_inimigo"
2d_physics/layer_6="plataformas"
2d_physics/layer_7="ganchos"
2d_physics/layer_8="pontos_fracos"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.105882354, 0.11764706, 0.16862746, 1)
2d/snap/snap_2d_transforms_to_pixel=true
