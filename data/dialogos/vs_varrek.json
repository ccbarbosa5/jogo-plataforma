 "cenas": {
  "abertura": {
   "modo": "conversa",
   "uma_vez": "abertura_vista",
   "falas": [
    {
     "id": "ABER_01",
     "falante": "ECO",
     "texto": "Molde 4. Reconstrução concluída. Batimentos: presentes. Sarcasmo: carregando.",
     "expressao": "sorriso"
    },
    {
     "id": "ABER_02",
     "falante": "RYKER",
     "texto": "...Eu morri.",
     "expressao": "abalado"
    },
    {
     "id": "ABER_03",
     "falante": "ECO",
     "texto": "Morreu. Com bastante estilo, segundo os registros. Sua nave atravessou um Portão quebrado e caiu aqui em pedaços. Você estava em vários deles."
    },
    {
     "id": "ABER_04",
     "falante": "RYKER",
     "texto": "Quem é você? Onde eu tô?"
    },
    {
     "id": "ABER_05",
     "falante": "ECO",
     "texto": "Eu sou a ECO. Esta é a Eco. Sim, a nave e eu temos o mesmo nome. Não fui eu que escolhi.",
     "expressao": "sorriso"
    },
    {
     "id": "ABER_06",
     "falante": "RYKER",
     "texto": "E quem escolheu?"
    },
    {
     "id": "ABER_07",
     "falante": "ECO",
     "texto": "Pessoas que dormem há muito tempo.",
     "expressao": "distante",
     "aud": "zumbido",
     "duvida": 1
    },
    {
     "id": "ABER_08",
     "falante": "RYKER",
     "texto": "...Você reconstruiu até a algema.",
     "direcao": "olha para o pulso, onde ainda está a algema"
    },
    {
     "id": "ABER_09",
     "falante": "ECO",
     "texto": "Eu poderia ter tirado. Achei que você ia querer decidir isso sozinho.",
     "direcao": "passa os dedos de luz pela algema; eles atravessam"
    },
    {
     "id": "ABER_10",
     "falante": "RYKER",
     "texto": "...Tá. Valeu, eu acho. Agora me larga num planeta humano qualquer e a gente fica quite.",
     "expressao": "deboche",
     "direcao": "pausa"
    },
    {
     "id": "ABER_11",
     "falante": "ECO",
     "texto": "Não existe planeta humano neste setor. Você está muito longe de casa, Ryker. Mas existe isto.",
     "expressao": "preocupada"
    },
    {
     "id": "ABER_12",
     "falante": "SINAL",
     "texto": "...qualquer um... Varrek... ainda estamos vivos...",
     "direcao": "chiado, voz humana falhando"
    },
    {
     "id": "ABER_13",
     "falante": "RYKER",
     "texto": "...Humanos."
    },
    {
     "id": "ABER_14",
     "falante": "ECO",
     "texto": "O sinal vem de Varrek, o planeta logo abaixo. Um cemitério de naves. Os Kharn e os Vesh estão em guerra lá embaixo."
    },
    {
     "id": "ABER_15",
     "falante": "RYKER",
     "texto": "Kharn. Claro que tem Kharn.",
     "expressao": "raiva"
    },
    {
     "id": "ABER_16",
     "falante": "ECO",
     "texto": "Eu posso te mandar lá para baixo. E posso te trazer de volta se você morrer. De novo. Mas a escolha é sua."
    },
    {
     "id": "ABER_17",
     "falante": "RYKER",
     "texto": "E o que você ganha com isso?"
    },
    {
     "id": "ABER_18",
     "falante": "ECO",
     "texto": "Tem uma peça minha lá embaixo. E... faz muito tempo que ninguém fica aqui comigo. Eu ganho companhia.",
     "expressao": "sorriso"
    }
   ]
  },
  "hangar_primeira": {
   "modo": "conversa",
   "uma_vez": "hangar_visto",
   "falas": [
    {
     "id": "HANG_01",
     "falante": "ECO",
